# Copy this file to .env and fill in your values.
# Never share your .env file or commit it to git.

# ── Required ─────────────────────────────────────────────────────────────────

# From the Discord Developer Portal → Your Application → Bot → Token
DISCORD_BOT_TOKEN=your_bot_token_here

# Right-click your server → Copy Server ID (enable Developer Mode in Discord settings first)
GUILD_ID=your_guild_id_here

# ── Set automatically by /init — leave blank unless pre-configuring manually ─

# POLL_CHANNEL_ID=
# DM_NOTIFY_CHANNEL_ID=

# ── Optional defaults (overridable via /init or admin commands) ───────────────

SESSION_DAY=Saturday

# Comma-separated list of extra text channels created in the D&D category by /init
# EXTRA_CHANNELS=general,maps,notes,pictures
